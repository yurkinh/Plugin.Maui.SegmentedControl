<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0;net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<!-- The WinUI XAML compiler only runs on Windows, so the Windows TFM is built (and packed) on Windows only.
		     Release packages must be packed on Windows (release-nuget.yml runs on windows-latest). -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>		
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>		

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
		

		<!-- NuGet -->
		<Authors>yurkinh</Authors>
		<Copyright>Copyright © yurkinh and contributors</Copyright>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageVersion>3.0.1</PackageVersion>
		<IsPackable>True</IsPackable>
		<PackageProjectUrl>https://github.com/yurkinh/Plugin.Maui.SegmentedControl</PackageProjectUrl>
		<RepositoryUrl>https://github.com/yurkinh/Plugin.Maui.SegmentedControl</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>dotnet-maui;maui;segmented;segment;segmentedtcontrol</PackageTags>
		<IncludeSymbols>True</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<Title>.NET MAUI Segmented Control Plugin</Title>
		<Description>Segmented Control for a .NET MAUI application.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<DebugType>portable</DebugType>
		<PackageIcon>nuget.png</PackageIcon>
		<PackageReleaseNotes>Targets .NET 11 / .NET MAUI 11 (for .NET 10 use the 2.x releases). Minimum Android API 24 and Mac Catalyst 17.0. iOS and Mac Catalyst now raise SegmentTapped and honour GroupToggleBehavior, matching Android and Windows. Windows (WinUI 3) support.</PackageReleaseNotes>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Control\" />
	  <None Remove="Platforms\Apple\" />
	  <None Remove="Platforms\Android\" />
	  <None Remove="Platforms\Android\Resources\color\segmented_control_text.xml" />
	  <None Remove="Platforms\Android\Resources\drawable\segmented_control_background.xml" />
	  <None Remove="Platforms\Android\Resources\drawable\segmented_control_first_background.xml" />
	  <None Remove="Platforms\Android\Resources\drawable\segmented_control_last_background.xml" />
	  <None Remove="Platforms\Android\Resources\layout\RadioButton.axml" />
	  <None Remove="Platforms\Android\Resources\layout\RadioGroup.axml" />
	  <None Remove="Platforms\Android\Resources\values\colors.xml" />
	  <None Remove="Extensions\" />
	  <None Remove="Platforms\Windows\" />
	  <None Remove="Platforms\Windows\NativeSegmented\" />
	  <None Remove="Platforms\Windows\Themes\" />
	  <None Remove="Handlers\" />
	</ItemGroup>
	<ItemGroup>
	  <Folder Include="Control\" />
	  <Folder Include="Platforms\Apple\" />
	  <Folder Include="Platforms\Android\" />
	  <Folder Include="Extensions\" />
	  <Folder Include="Platforms\Windows\" />
	  <Folder Include="Platforms\Windows\NativeSegmented\" />
	  <Folder Include="Platforms\Windows\Themes\" />
	  <Folder Include="Handlers\" />
	</ItemGroup>
	<!-- Platforms\Apple\ holds the handler shared by iOS and Mac Catalyst. MAUI single-project only compiles
	     Platforms\<current platform>\ by default, so the shared folder is declared here. -->
	<ItemGroup>
	  <MauiPlatformSpecificFolder Include="Platforms\Apple\" TargetPlatformIdentifiers="ios;maccatalyst" />
	</ItemGroup>
	<!-- Platforms\Windows\**\*.xaml is included as a WinUI Page by the MAUI SDK automatically.
	     Do not add explicit <Page> items: duplicates make XamlCompiler.exe fail silently (exit code 1). -->
	<ItemGroup>
	  <AndroidResource Include="Platforms\Android\Resources\color\segmented_control_text.xml" />
	  <AndroidResource Include="Platforms\Android\Resources\drawable\segmented_control_background.xml" />
	  <AndroidResource Include="Platforms\Android\Resources\drawable\segmented_control_first_background.xml" />
	  <AndroidResource Include="Platforms\Android\Resources\drawable\segmented_control_last_background.xml" />
	  <AndroidResource Include="Platforms\Android\Resources\layout\RadioButton.axml" />
	  <AndroidResource Include="Platforms\Android\Resources\layout\RadioGroup.axml" />
	  <AndroidResource Include="Platforms\Android\Resources\values\colors.xml" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
	</ItemGroup>
	<!-- Package additions -->
	<ItemGroup>
		<None Include="..\..\nuget.png" PackagePath="nuget.png" Pack="true" />
		<None Include="..\..\README.md" PackagePath="README.md" Pack="true" />
		<None Include="..\..\THIRD-PARTY-NOTICES.md" PackagePath="THIRD-PARTY-NOTICES.md" Pack="true" />
	</ItemGroup>
	<!-- Windows: the package only needs the .dll and .pri. The .pri embeds the compiled XAML, and consuming apps merge it
	     into their resources.pri, so ms-appx:///Plugin.Maui.SegmentedControl/... resolves without loose .xaml/.xbf files. -->
</Project>
